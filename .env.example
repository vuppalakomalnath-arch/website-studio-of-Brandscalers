# Environment Configuration for Website Builder 2.0
# Spec: No secrets in client bundles. No production keys or databases used.

# Google Gemini API Key for Server-Side Generation Pipeline
# Used by gemini-3 (planning) and gemini-3.1-flash-lite (section content & repairs)
# If omitted, the engine runs in [DEMO / LOCAL FIXTURE MODE]
GEMINI_API_KEY=your_gemini_api_key_here

# Generation Budget & Guard
INITIAL_BUILD_CREDIT_CAP=250

# Mode
NODE_ENV=development
